providers:
  ollama:
    model: "gemma4:latest"
    embedding: "bge-m3:latest"
    base_url: http://localhost:11434/v1
    api_env: OLLAMA_API_KEY
    temperature: 0.7
    max_retries: 8
    min_sleep: 6.0
    max_delay: 60.0
  # openai:
  #   model: gpt-4o
  #   embedding: text-embedding-3-small
  #   base_url: https://api.openai.com/v1
  #   api_env: OPENAI_API_KEY
  #   temperature: 0.7
  #   max_retries: 8
  #   min_sleep: 6.0
  #   max_delay: 60.0

llm_provider: ollama
embedding_provider: ollama
